{
  "name": "@atlas/contracts",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "react-native": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./dist/index.cjs",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build:node": "esbuild src/index.ts --bundle --platform=node --format=cjs --external:@atlas/core --outfile=dist/index.cjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@atlas/core": "workspace:*",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
