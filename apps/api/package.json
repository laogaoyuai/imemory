{
  "name": "@atlas/api",
  "version": "0.0.2",
  "private": true,
  "scripts": {
    "dev": "tsc-watch -p tsconfig.build.json --onSuccess \"node dist/src/main.js\"",
    "generate": "prisma generate",
    "typecheck": "pnpm generate && tsc --noEmit",
    "pretest": "pnpm --filter @atlas/core build:node && pnpm --filter @atlas/contracts build:node",
    "test": "jest --config jest.config.cjs --runInBand",
    "prebuild": "pnpm --filter @atlas/core build:node && pnpm --filter @atlas/contracts build:node",
    "build": "pnpm generate && tsc -p tsconfig.build.json",
    "start": "node dist/src/main.js"
  },
  "dependencies": {
    "@atlas/contracts": "workspace:*",
    "@atlas/core": "workspace:*",
    "@aws-sdk/client-s3": "3.1116.0",
    "@aws-sdk/s3-request-presigner": "3.1115.0",
    "@nestjs/common": "11.2.1",
    "@nestjs/core": "11.2.1",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.1",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "dotenv": "^17.2.3",
    "express": "5.2.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@swc/jest": "^0.2.39",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "jest": "^30.1.3",
    "prisma": "7.9.1",
    "tsc-watch": "7.2.1",
    "tsx": "^4.20.6"
  }
}
