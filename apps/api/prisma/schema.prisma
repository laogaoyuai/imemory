generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "cjs"
  generatedFileExtension = "ts"
  importFileExtension    = ""
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum ProjectRole {
  OWNER
  ADMIN
  MEMBER
  FOLLOWER
}

enum ContentVersionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UploadStatus {
  PENDING
  READY
  QUARANTINED
  REJECTED
}

model User {
  id               String           @id @default(uuid()) @db.Uuid
  wechatOpenId     String           @unique @map("wechat_open_id")
  wechatUnionId    String?          @unique @map("wechat_union_id")
  displayName      String           @default("微信用户") @map("display_name") @db.VarChar(40)
  avatarUrl        String?          @map("avatar_url") @db.Text
  bio              String           @default("") @db.VarChar(160)
  status           UserStatus       @default(ACTIVE)
  lastLoginAt      DateTime         @default(now()) @map("last_login_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  sessions         AuthSession[]
  contents         Content[]
  uploads          UploadObject[]
  ownedProjects    Project[]        @relation("ProjectOwner")
  projectMembers   ProjectMember[]
  collections      Collection[]
  comments         Comment[]
  versions         ContentVersion[] @relation("SubmittedVersions")
  reviewedVersions ContentVersion[] @relation("ReviewedVersions")
  commentLikes     CommentLike[]
  idempotency      IdempotencyKey[]
  following        UserFollow[]     @relation("UserFollowing")
  followers        UserFollow[]     @relation("UserFollowers")

  @@map("users")
}

model UserFollow {
  followerId  String   @map("follower_id") @db.Uuid
  followingId String   @map("following_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId, createdAt])
  @@map("user_follows")
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.Char(64)
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("auth_sessions")
}

model Content {
  id                   String               @id @db.VarChar(128)
  ownerId              String               @map("owner_id") @db.Uuid
  kind                 String               @db.VarChar(24)
  title                String               @default("") @db.VarChar(120)
  payload              Json
  revision             Int                  @default(1)
  currentVersionStatus ContentVersionStatus @default(APPROVED) @map("current_version_status")
  clientUpdatedAt      DateTime             @map("client_updated_at")
  deletedAt            DateTime?            @map("deleted_at")
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")
  owner                User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  versions             ContentVersion[]
  comments             Comment[]
  collectionItems      CollectionItem[]
  projectLinks         ContentProject[]

  @@index([ownerId, updatedAt])
  @@index([ownerId, kind, deletedAt])
  @@map("contents")
}

model ContentVersion {
  id            String               @id @default(uuid()) @db.Uuid
  contentId     String               @map("content_id") @db.VarChar(128)
  version       String               @db.VarChar(32)
  status        ContentVersionStatus @default(APPROVED)
  snapshot      Json
  submittedById String               @map("submitted_by_id") @db.Uuid
  reviewedById  String?              @map("reviewed_by_id") @db.Uuid
  reviewedAt    DateTime?            @map("reviewed_at")
  createdAt     DateTime             @default(now()) @map("created_at")
  content       Content              @relation(fields: [contentId], references: [id], onDelete: Cascade)
  submittedBy   User                 @relation("SubmittedVersions", fields: [submittedById], references: [id], onDelete: Restrict)
  reviewedBy    User?                @relation("ReviewedVersions", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([contentId, version])
  @@index([contentId, createdAt])
  @@index([status, createdAt])
  @@map("content_versions")
}

model UploadObject {
  id         String       @id @default(uuid()) @db.Uuid
  ownerId    String       @map("owner_id") @db.Uuid
  objectKey  String       @unique @map("object_key") @db.Text
  kind       String       @db.VarChar(24)
  fileName   String       @map("file_name") @db.VarChar(180)
  mimeType   String       @map("mime_type") @db.VarChar(160)
  size       Int
  status     UploadStatus @default(PENDING)
  createdAt  DateTime     @default(now()) @map("created_at")
  verifiedAt DateTime?    @map("verified_at")
  owner      User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, createdAt])
  @@map("upload_objects")
}

model Project {
  id          String          @id @default(uuid()) @db.Uuid
  ownerId     String          @map("owner_id") @db.Uuid
  name        String          @db.VarChar(80)
  description String          @default("") @db.VarChar(500)
  avatarUrl   String?         @map("avatar_url") @db.Text
  isPublic    Boolean         @default(false) @map("is_public")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  owner       User            @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members     ProjectMember[]
  contents    ContentProject[]

  @@unique([ownerId, name])
  @@map("projects")
}

model ContentProject {
  contentId String   @map("content_id") @db.VarChar(128)
  projectId String   @map("project_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([contentId, projectId])
  @@index([projectId, createdAt])
  @@map("content_projects")
}

model ProjectMember {
  projectId String      @map("project_id") @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  role      ProjectRole
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId, role])
  @@map("project_members")
}

model Collection {
  id          String           @id @default(uuid()) @db.Uuid
  ownerId     String           @map("owner_id") @db.Uuid
  name        String           @db.VarChar(80)
  description String           @default("") @db.VarChar(240)
  coverUrl    String?          @map("cover_url") @db.Text
  type        String           @db.VarChar(24)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  owner       User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  items       CollectionItem[]

  @@unique([ownerId, name])
  @@map("collections")
}

model CollectionItem {
  collectionId String     @map("collection_id") @db.Uuid
  contentId    String     @map("content_id") @db.VarChar(128)
  position     Int
  createdAt    DateTime   @default(now()) @map("created_at")
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  content      Content    @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@id([collectionId, contentId])
  @@unique([collectionId, position])
  @@map("collection_items")
}

model Comment {
  id          String    @id @default(uuid()) @db.Uuid
  contentId   String    @map("content_id") @db.VarChar(128)
  authorId    String    @map("author_id") @db.Uuid
  body        String    @db.VarChar(2000)
  replyToId   String?   @map("reply_to_id") @db.Uuid
  likeCount   Int       @default(0) @map("like_count")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  content     Content   @relation(fields: [contentId], references: [id], onDelete: Cascade)
  author      User      @relation(fields: [authorId], references: [id], onDelete: Restrict)
  replyTo     Comment?  @relation("CommentReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies     Comment[] @relation("CommentReplies")
  likes       CommentLike[]

  @@index([contentId, createdAt])
  @@map("comments")
}

model CommentLike {
  commentId String   @map("comment_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
  @@index([userId, createdAt])
  @@map("comment_likes")
}

model IdempotencyKey {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  scope        String   @db.VarChar(80)
  key          String   @db.Uuid
  responseBody Json     @map("response_body")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, scope, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}
