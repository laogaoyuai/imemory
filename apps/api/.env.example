NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://atlas:atlas@127.0.0.1:5432/atlas?schema=public
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=false
REQUEST_BODY_LIMIT_BYTES=1048576
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=180
AUTH_RATE_LIMIT_MAX=20
# Defaults to true in production and false elsewhere.
LOG_REQUESTS=

# Use mock only for local development. Production enforces live mode.
WECHAT_AUTH_MODE=mock
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# Production enforces WeChat text security checks.
CONTENT_SECURITY_MODE=disabled
WECHAT_SECURITY_TIMEOUT_MS=8000

# Set STORAGE_MODE=s3 for production. S3-compatible services are supported.
STORAGE_MODE=disabled
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=
STORAGE_FORCE_PATH_STYLE=false
